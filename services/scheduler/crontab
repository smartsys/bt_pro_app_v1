SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# GEÄNDERT: python3 mit -B aufrufen. Der Scheduler läuft als root (cron
# verlangt das) und teilt sich /app/services mit App und Worker, die als uid 1000
# laufen. Ohne -B legt er dort root-eigene __pycache__-Ordner an, die die anderen
# Container nicht mehr beschreiben können.
# GEÄNDERT: cron vererbt die Container-Umgebung (POSTGRES_SERVER und die
# übrigen DB-/Redis-Zugänge) nicht an die Jobs weiter. Deshalb wird vor jedem Aufruf
# /etc/cron_env.sh gesourced — die Datei erzeugt der Entrypoint beim Container-Start
# aus der echten Prozessumgebung (siehe services/scheduler/entrypoint.sh). Die
# Klammerung fasst cd/source/Aufruf zu einem Kommando zusammen, damit die Umleitung
# ">> ... 2>&1" auch einen Fehler beim Sourcen selbst sichtbar ins Log schreibt statt
# ihn still verschwinden zu lassen (cron hat sonst keinen Mail-Transport im Container).
*/5 * * * * root ( cd /app && . /etc/cron_env.sh && python3 -B services/api/enqueue_reindex.py ) >> /var/log/cron.log 2>&1
*/5 * * * * root ( cd /app && . /etc/cron_env.sh && python3 -B services/api/reap_stale_jobs.py ) >> /var/log/cron.log 2>&1
*/5 * * * * root ( cd /app && . /etc/cron_env.sh && python3 -B services/api/reap_stale_runs.py ) >> /var/log/cron.log 2>&1
